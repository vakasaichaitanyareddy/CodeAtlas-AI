# ==============================================================================
# CodeAtlas Environment Configuration Example
# Copy this file to .env and provide your actual credentials
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-to-a-secure-random-string-in-production-min-32-chars
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL 16
POSTGRES_USER=codeatlas
POSTGRES_PASSWORD=codeatlas_secret
POSTGRES_DB=codeatlas_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://codeatlas:codeatlas_secret@localhost:5432/codeatlas_db
DATABASE_SYNC_URL=postgresql://codeatlas:codeatlas_secret@localhost:5432/codeatlas_db

# Redis 7
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Authentication & Security
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# AI / Model Providers
# Options: "gemini" | "openai" | "mock"
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini
RERANKER_PROVIDER=mock

# Google Gemini API
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# OpenAI API (Optional alternative)
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# GitHub OAuth / Integration (Optional for local testing, used in production)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_PERSONAL_ACCESS_TOKEN=

# Observability
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
